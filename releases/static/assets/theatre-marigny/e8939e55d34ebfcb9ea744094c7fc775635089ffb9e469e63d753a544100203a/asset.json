uilding pyramidal tag, an explicit inference from the low surrounding roof in the photograph.","Pilaster width, cornice thickness and repeated foyer/lantern windows are map-scale inferences. Inscriptions, ornate cresting, sculpture and fine lantern grille are omitted; the standard grey roof and light-blue glazing palette replaces photographic colors."],"source":{"url":"/objects/fb34a88d736dea94ce0d6d3baf45858e480d131dbba8dcd1322dada8b60c8e35/source.blend.gz","bytes":108567,"sha256":"fb34a88d736dea94ce0d6d3baf45858e480d131dbba8dcd1322dada8b60c8e35"},"spatialSource":{"url":"/objects/bb846a732644a35aa15e6d4b775285e602d5baf6868ea6fe44bd89619a952adb/spatial-source.json","bytes":6856,"sha256":"bb846a732644a35aa15e6d4b775285e602d5baf6868ea6fe44bd89619a952adb"},"preview":{"url":"/objects/fa124733fe221499ddb217c430c79b7e2006c966ed885adbb91f2780c824de77/preview.webp","bytes":6842,"sha256":"fa124733fe221499ddb217c430c79b7e2006c966ed885adbb91f2780c824de77"},"revision":"afdd8551e943c4329e90ee40bb9d7fa3dd93e0f4ae2a4f9d5b23f02fb6bfc2ff","publicationRevision":"e8939e55d34ebfcb9ea744094c7fc775635089ffb9e469e63d753a544100203a","bounds":[2.3134079,48.8685168,2.3141077,48.8689185],"approved":false,"materialLibrary":{"schemaVersion":1,"sha256":"3b5a90bef8f8d24f4a3e0370016ca377b424f60119e8245e165cbcc5e7ea53ef","url":"/materials/3b5a90bef8f8d24f4a3e0370016ca377b424f60119e8245e165cbcc5e7ea53ef.json"},"metadata":"/assets/theatre-marigny/e8939e55d34ebfcb9ea744094c7fc775635089ffb9e469e63d753a544100203a/asset.json","validation":"/assets/theatre-marigny/e8939e55d34ebfcb9ea744094c7fc775635089ffb9e469e63d753a544100203a/validation.json"}