uilding pyramidal tag, an explicit inference from the low surrounding roof in the photograph.","Pilaster width, cornice thickness and repeated foyer/lantern windows are map-scale inferences. Inscriptions, ornate cresting, sculpture and fine lantern grille are omitted; the standard grey roof and light-blue glazing palette replaces photographic colors."],"source":{"url":"/objects/f6d2ef40f7774ab446ab318e671fd41151a019f32f75630dd1e1663bc69c6fda/source.blend.gz","bytes":113179,"sha256":"f6d2ef40f7774ab446ab318e671fd41151a019f32f75630dd1e1663bc69c6fda"},"spatialSource":{"url":"/objects/bb846a732644a35aa15e6d4b775285e602d5baf6868ea6fe44bd89619a952adb/spatial-source.json","bytes":6856,"sha256":"bb846a732644a35aa15e6d4b775285e602d5baf6868ea6fe44bd89619a952adb"},"preview":{"url":"/objects/08970944c8abdb10f1b7496fc406ac2fbacb5c140d95ed420420fb8445b17183/preview.webp","bytes":8126,"sha256":"08970944c8abdb10f1b7496fc406ac2fbacb5c140d95ed420420fb8445b17183"},"revision":"eeb77f57cf118afd5a95066e49e17c03dcd3b0ea87c4016bf99875e29f4356d5","publicationRevision":"85e32fae884e6c53a12a6fc75a645059058b9a62706735b72dead217e746b77f","bounds":[2.3134079,48.8685168,2.3141077,48.8689185],"approved":false,"materialLibrary":{"schemaVersion":1,"sha256":"7afc40cf0b82b7c3c054f287817be2a37e52192aa734f187f8b20ee3277187dd","url":"/materials/7afc40cf0b82b7c3c054f287817be2a37e52192aa734f187f8b20ee3277187dd.json"},"metadata":"/assets/theatre-marigny/85e32fae884e6c53a12a6fc75a645059058b9a62706735b72dead217e746b77f/asset.json","validation":"/assets/theatre-marigny/85e32fae884e6c53a12a6fc75a645059058b9a62706735b72dead217e746b77f/validation.json"}