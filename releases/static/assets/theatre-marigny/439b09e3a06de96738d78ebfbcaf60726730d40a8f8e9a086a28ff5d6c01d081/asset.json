uilding pyramidal tag, an explicit inference from the low surrounding roof in the photograph.","Pilaster width, cornice thickness and repeated foyer/lantern windows are map-scale inferences. Inscriptions, ornate cresting, sculpture and fine lantern grille are omitted; the standard grey roof and light-blue glazing palette replaces photographic colors."],"source":{"url":"/objects/caf3a5b49b7e65cbdcb360c32cd10dceaf07fd2729159bdbaaaf5f8deccb3ad3/source.blend.gz","bytes":108482,"sha256":"caf3a5b49b7e65cbdcb360c32cd10dceaf07fd2729159bdbaaaf5f8deccb3ad3"},"spatialSource":{"url":"/objects/bb846a732644a35aa15e6d4b775285e602d5baf6868ea6fe44bd89619a952adb/spatial-source.json","bytes":6856,"sha256":"bb846a732644a35aa15e6d4b775285e602d5baf6868ea6fe44bd89619a952adb"},"preview":{"url":"/objects/0a8b7bd91e03b9bd93321096a3510ccfc947a4fff4fcb7e45ba3d7b61729df5f/preview.webp","bytes":7290,"sha256":"0a8b7bd91e03b9bd93321096a3510ccfc947a4fff4fcb7e45ba3d7b61729df5f"},"revision":"56c983d64dff3ea27eb2e9ae8dfe0d2fd9d55cd18d27f215dfca3bf5d42f2563","publicationRevision":"439b09e3a06de96738d78ebfbcaf60726730d40a8f8e9a086a28ff5d6c01d081","bounds":[2.3134079,48.8685168,2.3141077,48.8689185],"approved":false,"materialLibrary":{"schemaVersion":1,"sha256":"121eb8f661cd76df4f6ea710947bfce0cace2e6aef7fda643b2d4407a7fbb3c9","url":"/materials/121eb8f661cd76df4f6ea710947bfce0cace2e6aef7fda643b2d4407a7fbb3c9.json"},"metadata":"/assets/theatre-marigny/439b09e3a06de96738d78ebfbcaf60726730d40a8f8e9a086a28ff5d6c01d081/asset.json","validation":"/assets/theatre-marigny/439b09e3a06de96738d78ebfbcaf60726730d40a8f8e9a086a28ff5d6c01d081/validation.json"}