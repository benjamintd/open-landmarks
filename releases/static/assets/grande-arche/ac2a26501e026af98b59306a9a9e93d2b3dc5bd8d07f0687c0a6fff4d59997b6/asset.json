97783169,35184993709546,35185347090703],"toleranceM":0.75,"sourceZoom":15},"osm":{"type":"way","id":19441489,"version":31,"timestamp":"2025-11-02T18:01:37Z","url":"https://www.openstreetmap.org/way/19441489"},"additionalOsm":[],"rightsStatus":"approved","geometryStatus":"approved","attribution":"Open Landmarks; contains © OpenStreetMap contributors, ODbL-1.0","references":[{"title":"File:Grande Arche, France - April 2011.jpg","author":"Cristian Bortes from Cluj-Napoca, Romania","license":"CC BY 2.0","licenseUrl":"https://creativecommons.org/licenses/by/2.0","sourcePage":"https://commons.wikimedia.org/wiki/File:Grande_Arche,_France_-_April_2011.jpg","sourceSha1":"34f4a850af75725279254c2063bb72980e323143","use":"visual-reference-only","view":"Square open portal silhouette"},{"title":"File:North facade of the Grande Arche de la Défense - 20050906.jpg","author":"Tognopop","license":"CC0","licenseUrl":"https://creativecommons.org/publicdomain/zero/1.0/deed.en","sourcePage":"https://commons.wikimedia.org/wiki/File:North_facade_of_the_Grande_Arche_de_la_D%C3%A9fense_-_20050906.jpg","sourceSha1":"39b5dcdbdeb2aa1a74e22bd26b9095e4fa2e7ba7","use":"visual-reference-only","view":"Glazed side facade"}],"aliases":[],"authors":["Open Landmarks contributors"],"artisticLicense":"CC-BY-4.0","spatialDataLicense":"ODbL-1.0","licenseScope":"CC BY applies to original artistic contributions only; ODbL applies to OSM-derived spatial data. Reference photographs retain their own licenses.","assistance":"AI-assisted architectural interpretation and procedural recipe authoring; deterministic Python/Blender export. No photographic textures.","review":{"status":"approved","revision":"10e066891744d45ef4372e50edeeaa161b38b4b04b22cbdb74c83f5467b64912","reviewer":"Benjamin TD","reviewedAt":"2026-09-30","checks":{"rights":"passed","footprint":"passed","appearance":"passed","mapIntegration":"passed"}},"modelingNotes":["From OSM (24 mapped parts): the two 110 m side blocks (18.7 m thick, 112 m long, outer faces 106.9 m apart, tapering with 45 degree plan chamfers toward both ends of the passage), the 69.4 m wide void, and the 13 stepped parvis levels (0.63 m risers, 8.3 m platform). The frame is built along the axis joining the two side-block centroids.","Published (Wikipedia FR/EN, Paris La Defense): 112 m deep, 106.9 m wide, ~110 m high, a hollowed cube big enough for Notre-Dame, marble and glass cladding, 4 x 4 concrete transfer beams under the roof, Carrara marble on the end and void faces, glass curtain walls on the long outer faces.","Inferred: the OSM roof layers (min_height 101-108 m) are read as a 45 degree splay of the beam soffit toward the chamfered ends, and the beam soffit is set at 91.3 m so the roof beam is as deep as the side walls (18.7 m, square frame section) as the Commons photographs show. Storey pitch 2.75 m (about 39 levels). Panoramic lift core and the Nuage sail (suspended in the void, 28-40 m up) are simplified; their dimensions are not surveyed.","Materials: stone = marble, roof = grey glass curtain wall and terrace, window = glazing, trim = reveals and mullions."],"source":{"url":"/objects/e38f9192020f77453a6ce6aec7b7220d6a3b022b88dea18e9ff39215e6dcf7cd/source.blend.gz","bytes":305057,"sha256":"e38f9192020f77453a6ce6aec7b7220d6a3b022b88dea18e9ff39215e6dcf7cd"},"spatialSource":{"url":"/objects/49e01b34777073ec461d9a4bcaa2712cbe4ebc223726ccd2b844574240c413fd/spatial-source.json","bytes":15120,"sha256":"49e01b34777073ec461d9a4bcaa2712cbe4ebc223726ccd2b844574240c413fd"},"preview":{"url":"/objects/a74b9f7b3571a6acb1e42e5cf17c8d3fcd123b579d41abf624c3a2c751a4d243/preview.webp","bytes":36234,"sha256":"a74b9f7b3571a6acb1e42e5cf17c8d3fcd123b579d41abf624c3a2c751a4d243"},"revision":"10e066891744d45ef4372e50edeeaa161b38b4b04b22cbdb74c83f5467b64912","publicationRevision":"ac2a26501e026af98b59306a9a9e93d2b3dc5bd8d07f0687c0a6fff4d59997b6","bounds":[2.2348404,48.8918899,2.2369091,48.8932391],"approved":true,"materialLibrary":{"schemaVersion":1,"sha256"